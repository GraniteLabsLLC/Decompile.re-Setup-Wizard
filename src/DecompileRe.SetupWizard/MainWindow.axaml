<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DecompileRe.SetupWizard.ViewModels"
        xmlns:models="using:DecompileRe.SetupWizard.Core.Models"
        x:Class="DecompileRe.SetupWizard.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Decompile.re Setup"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="250,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="#14171B" BorderBrush="#282C32" BorderThickness="0,0,1,0">
      <Grid Margin="28" RowDefinitions="Auto,36,*">
        <StackPanel>
          <TextBlock Text="Decompile.re" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="IDA Pro Setup" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="19">
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding Step1Background}">
              <TextBlock Text="1" Foreground="{Binding Step1Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Welcome" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding Step2Background}">
              <TextBlock Text="2" Foreground="{Binding Step2Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Select IDA" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding Step3Background}">
              <TextBlock Text="3" Foreground="{Binding Step3Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Review" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="25" Height="25" CornerRadius="13" Background="{Binding Step4Background}">
              <TextBlock Text="4" Foreground="{Binding Step4Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Install" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="50,42,50,24">
      <Grid>
        <StackPanel IsVisible="{Binding IsWelcome}" Spacing="18" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Install Decompile.re" FontSize="31" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="15" TextWrapping="Wrap"
                     Text="This wizard finds your IDA Pro installation, verifies the latest signed release, installs the required Python packages, and adds the plugin for your user account." />
          <Border Background="#171A1F" BorderBrush="#2B3037" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="Before continuing" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Close IDA Pro so the plugin files can be replaced safely. Administrator access is not required." />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDetection}" Spacing="16">
          <TextBlock Text="Select an IDA installation" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Detected installations are listed below. You can also select a custom location." />
          <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
          <ListBox ItemsSource="{Binding Installations}"
                   SelectedItem="{Binding SelectedInstallation}"
                   Background="Transparent"
                   BorderThickness="0"
                   MinHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:IdaInstallation">
                <Border Background="#171A1F" BorderBrush="#2B3037" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RootPath}" Classes="muted" FontSize="12" Margin="0,6,0,0" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,9,0,0">
                      <TextBlock Text="{Binding PythonLabel}" FontSize="12" />
                      <TextBlock Text="{Binding IdaPythonLabel}" FontSize="12" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="secondary" Content="Choose a custom IDA folder" Click="BrowseIda_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReview}" Spacing="16" MaxWidth="590" HorizontalAlignment="Left">
          <TextBlock Text="Ready to install" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Review the selected installation and release." />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,14,0,0">
            <TextBlock Text="Installation" Classes="muted" Margin="0,0,0,12" />
            <TextBlock Grid.Column="1" Text="{Binding SelectedInstallation.DisplayName}" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Text="Release" Classes="muted" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReleaseVersion}" Margin="0,0,0,12" />
            <TextBlock Grid.Row="2" Text="Python" Classes="muted" Margin="0,0,0,12" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInstallation.PythonLabel}" Margin="0,0,0,12" />
            <TextBlock Grid.Row="3" Text="Plugin directory" Classes="muted" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInstallation.UserPluginDirectory}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,12,0,0"
                     Text="Existing Decompile.re files will be backed up before the new release is activated." />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsInstalling}" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Installing Decompile.re" FontSize="27" FontWeight="SemiBold" />
          <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent}" Height="6" />
          <TextBlock Text="{Binding StatusMessage}" />
          <ItemsControl ItemsSource="{Binding ActivityLog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="muted" FontSize="12" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsComplete}" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Decompile.re is installed" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Open IDA Pro and select Decompile.re from the plugins menu. The plugin will guide you through browser sign-in." />
          <TextBlock Text="{Binding InstalledLocation}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Column="1" Grid.Row="1" BorderBrush="#282C32" BorderThickness="0,1,0,0" Padding="28,18">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="secondary" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#FF7777" TextWrapping="Wrap" Margin="18,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="primary" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanUsePrimary}" />
      </Grid>
    </Border>
  </Grid>
</Window>
