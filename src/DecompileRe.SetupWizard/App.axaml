<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DecompileRe.SetupWizard.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Background" Value="#0D0F12" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#E8F0FF" />
      <Setter Property="Foreground" Value="#11151B" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#20242A" />
      <Setter Property="Foreground" Value="#E8EAED" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#939AA5" />
    </Style>
  </Application.Styles>
</Application>
